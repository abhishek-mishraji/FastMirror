# FastMirror configuration.
# Place this file beside FastMirror.exe and rename it to .env
#
# SOURCE_FOLDER, MIRROR_FOLDER and INCLUDE_PREFIXES must be set. Every other key is
# shown with the default it already uses, so uncomment a line only to change it.

# The POS Link Archive folder. FastMirror only ever reads it.
SOURCE_FOLDER=C:/Program Files (x86)/CStore Essentials/POS Link/Service/Archive

# Where copies go. The S3 upload agent watches this folder.
MIRROR_FOLDER=C:/Users/Owner/Documents/HandsOff-Software/Tiki_8730_IN-47872/Mirrored_files

# --- What to copy from the Archive folder itself ---------------------------

# 3-letter file-name prefixes to copy, comma-separated. Case does not matter.
INCLUDE_PREFIXES=CPJ,SUM,MCM,ISM,MSM,HRS,FGM,FCF,LYT,TPM

# File extensions to copy, comma-separated.
# INCLUDE_EXTENSIONS=xml

# How copies are grouped below <PREFIX>/<year>/<month>:
#   DATE  -> CPJ/2026/october/2026-10-15/CPJ432.xml
#   MONTH -> CPJ/2026/october/CPJ432.xml
# The date is the day the file was created in the Archive folder.
# GROUP_BY=DATE

# --- Subfolders of the Archive folder --------------------------------------

# Subfolders whose files are copied too, comma-separated. Empty means none.
# Only files directly inside each subfolder are copied, with no prefix filter,
# and they are always grouped by month: Journals/2026/october/<file>
# INCLUDE_SUBFOLDERS=

# File extensions to copy from those subfolders.
# SUBFOLDER_EXTENSIONS=pdf

# --- When to copy ----------------------------------------------------------

# Copy only files created on or after this date (yyyy-MM-dd). Empty copies
# everything already in the Archive.
# COPY_FROM_DATE=

# A file is copied only once its size and modified time have not changed for
# this many minutes. Range 1 to 1440.
# STABILITY_MINUTES=3

# How often the Archive folder is checked, in seconds. Range 10 to 3600.
# SCAN_INTERVAL_SECONDS=60

# --- Optional tuning -------------------------------------------------------

# Copy worker threads. Also the cap on how many Archive files FastMirror can
# have open at once.
# COPY_WORKERS=4

# How hard to retry a file that another process has locked, before leaving it
# for the next scan. The delay doubles each attempt: 5, 10, 20, 40, 80 ms.
# OPEN_RETRY_ATTEMPTS=5
# OPEN_RETRY_INITIAL_MS=5

# Skip files larger than this many bytes. 0 means no limit.
# MAX_COPY_BYTES=0

# Filename patterns never copied.
# EXCLUDE_PATTERNS=~$*,*.tmp,*.fmtmp

# How often the counter summary is written to the log.
# STATS_INTERVAL_MS=60000

# Log destination, relative to the exe unless an absolute path is given.
# LOG_FOLDER=logs

# Where the record of already-copied files (copied.ledger) is kept, relative to
# the exe unless an absolute path is given. Must be outside both folders above.
# Deleting copied.ledger makes FastMirror copy everything again.
# STATE_FOLDER=state
