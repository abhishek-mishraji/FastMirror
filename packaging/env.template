# FastMirror configuration.
# Place this file beside FastMirror.exe and rename it to .env
#
# SOURCE_FOLDER, MIRROR_FOLDER and INCLUDE_PREFIXES must be set. Every other key is
# shown with the default it already uses, so uncomment a line only to change it.

# The POS Link Archive folder. FastMirror only ever reads it.
SOURCE_FOLDER=C:/Program Files (x86)/CStore Essentials/POS Link/Service/Archive

# Where copies go. The S3 upload agent watches this folder.
MIRROR_FOLDER=C:/Users/Owner/Documents/HandsOff-Software/Tiki_8730_IN-47872/Mirrored_files

# --- What to copy from the Archive folder itself ---------------------------

# 3-letter file-name prefixes to copy, comma-separated. Case does not matter.
INCLUDE_PREFIXES=CPJ,SUM,MCM,ISM,MSM,HRS,FGM,FCF,LYT,TPM

# File extensions to copy, comma-separated.
# INCLUDE_EXTENSIONS=xml

# --- Which date picks the folder -------------------------------------------

# Where a file's date comes from:
#   CONTENT  - the business date written INSIDE the file (recommended). Exact
#              for every file that carries one, whatever time it was written.
#   FILENAME - the date written in the file name, found with FILENAME_DATE_PATTERN.
#   CREATED  - the day the file was created in the source folder (default).
# The same date is used for COPY_FROM_DATE. A file without a date where one
# is expected falls back to its creation date, with a warning in the log.
# DATE_SOURCE=CREATED

# For CONTENT: the XML field(s) holding the business date, tried in order.
# Each name matches an element or an attribute, with or without a namespace
# prefix. The date is taken exactly as written (no time-zone conversion).
#   Gilbarco Passport (Wolf):  CONTENT_DATE_FIELDS=BusinessDate
#   Verifone Sapphire (Tiki):  CONTENT_DATE_FIELDS=periodEndDate,closedTime
#     (reports carry periodEndDate; the CPJ day journal carries closedTime -
#      its first <date> is the day before, so do not name "date")
# CONTENT_DATE_FIELDS=

# For CONTENT: how much of the start of each file is searched. The date is
# within the first 1.2 KB in every known format. Range 1024 to 16777216.
# CONTENT_SCAN_BYTES=65536

# Where the date sits in the file name. Line it up against a real name:
#   yyyy = 4-digit year   yy = 2-digit year   MM = month   dd = day
#   HH   = hour   mm = minute   ss = second   (optional; see BUSINESS_DAY_STARTS_AT)
#   ?    = any one character                  * = any number of characters
# Examples:
#   CPJ2026-09-13-590.xml            FILENAME_DATE_PATTERN=???yyyy-MM-dd*
#   StoreClose20260924000416.pdf     FILENAME_DATE_PATTERN=*yyyyMMddHHmmss.pdf
# A file whose name does not match falls back to its creation date, with a
# warning in the log.
# FILENAME_DATE_PATTERN=

# When the store's business day starts (HH:mm). A creation time, or a time read
# from a file name with HH, earlier than this belongs to the day before: with
# 03:00, a report printed at 00:04 on the 24th is the 23rd's. Never applied to
# CONTENT dates, which are business dates already. Default 00:00 (no shift).
# BUSINESS_DAY_STARTS_AT=00:00

# Time zone used to turn a creation time into a date (CREATED, and the
# fall-back). Not used for CONTENT dates, which are taken as written.
# Independent of the PC's own time zone. Names such as America/New_York,
# America/Chicago or UTC.
# TIME_ZONE=America/New_York

# --- Extra folders ---------------------------------------------------------

# More folders whose files are copied too, as full paths, comma-separated,
# such as a second output folder of the same POS. Empty means none.
#   INCLUDE_SUBFOLDERS=Z:/PassportReports
# Each folder's name becomes its folder in the mirror, so names must differ.
# Only files directly inside each folder are copied, with no prefix filter
# (use EXCLUDE_PATTERNS to leave some out), into their day folder:
#   PassportReports/2026/october/2026-10-15/<file>
# INCLUDE_SUBFOLDERS=

# File extensions to copy from those subfolders.
# SUBFOLDER_EXTENSIONS=pdf

# Where subfolder files get their date, set separately because they can be a
# different kind of file (such as PDFs). Same choices and rules as above.
# SUBFOLDER_DATE_SOURCE=CREATED
# SUBFOLDER_FILENAME_DATE_PATTERN=
# SUBFOLDER_CONTENT_DATE_FIELDS=

# --- When to copy ----------------------------------------------------------

# Copy only files created on or after this date (yyyy-MM-dd). Empty copies
# everything already in the Archive.
# COPY_FROM_DATE=

# A file is copied only once its size and modified time have not changed for
# this many minutes. Range 1 to 1440.
# STABILITY_MINUTES=3

# How often the Archive folder is checked, in seconds. Range 10 to 3600.
# SCAN_INTERVAL_SECONDS=60

# --- Optional tuning -------------------------------------------------------

# Copy worker threads. Also the cap on how many Archive files FastMirror can
# have open at once.
# COPY_WORKERS=4

# How hard to retry a file that another process has locked, before leaving it
# for the next scan. The delay doubles each attempt: 5, 10, 20, 40, 80 ms.
# OPEN_RETRY_ATTEMPTS=5
# OPEN_RETRY_INITIAL_MS=5

# Skip files larger than this many bytes. 0 means no limit.
# MAX_COPY_BYTES=0

# Filename patterns never copied.
# EXCLUDE_PATTERNS=~$*,*.tmp,*.fmtmp

# How often the counter summary is written to the log.
# STATS_INTERVAL_MS=60000

# Log destination, relative to the exe unless an absolute path is given.
# LOG_FOLDER=logs

# Where the record of already-copied files (copied.ledger) is kept, relative to
# the exe unless an absolute path is given. Must be outside both folders above.
# Deleting copied.ledger makes FastMirror copy everything again.
# STATE_FOLDER=state
