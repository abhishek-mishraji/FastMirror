# FastMirror configuration.
# Place this file beside FastMirror.exe and rename it to .env
#
# Only the first two keys are required. Every other key is shown with the default
# it already uses, so uncomment a line only to change it.

SOURCE_FOLDER=C:/Gemcom/bin/out
MIRROR_FOLDER=C:/temp

# --- Optional tuning -------------------------------------------------------

# Copy worker threads. Also the hard cap on how many of the producer's files
# FastMirror can have open at once.
# COPY_WORKERS=4

# How hard to retry a source file that another process has locked.
# The delay doubles each attempt: 5, 10, 20, 40, 80 ms.
# OPEN_RETRY_ATTEMPTS=5
# OPEN_RETRY_INITIAL_MS=5

# Full-tree sweep interval, the safety net for notifications Windows drops.
# Set to 0 to disable it and rely on events alone.
# SWEEP_INTERVAL_MS=500

# Compare SHA-256 as well as size and timestamp. Only needed if the producer can
# rewrite a file without changing either. Reads both files on every check.
# CONTENT_VERIFY=false

# Publish bytes captured before a read failure instead of discarding them.
# Leave this on unless a downstream consumer cannot tolerate a truncated file.
# PUBLISH_PARTIAL=true

# Create source subdirectories in the mirror even when they contain no files.
# MIRROR_EMPTY_DIRECTORIES=false

# Skip files larger than this many bytes. 0 means no limit.
# MAX_COPY_BYTES=0

# Filename patterns never copied.
# EXCLUDE_PATTERNS=~$*,*.tmp,*.fmtmp

# How often the counter summary is written to the log.
# STATS_INTERVAL_MS=60000

# Log destination, relative to the exe unless an absolute path is given.
# LOG_FOLDER=logs
