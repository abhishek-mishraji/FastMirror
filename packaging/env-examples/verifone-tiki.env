# FastMirror .env for a VERIFONE (Sapphire format) store fed by CStore Essentials POS Link.
# Example store: Tiki (8730_IN-47872).
#
# Copy this file beside FastMirror.exe, rename it to .env, check the two folders, start the agent.
# Every key is explained in packaging/env.template.

# --- Folders -----------------------------------------------------------------

SOURCE_FOLDER=C:/Program Files (x86)/CStore Essentials/POS Link/Service/Archive
MIRROR_FOLDER=C:/Users/Owner/Documents/HandsOff-Software/Tiki_8730_IN-47872/Mirrored_files

# --- What to copy --------------------------------------------------------------

# File types, by the first 3 letters of the name. Verifone's letters do not mean the same as
# Passport's (here MSM is the tax report and SUM the summary).
INCLUDE_PREFIXES=CPJ,SUM,MCM,ISM,MSM,HRS,FGM,FCF,LYT,TPM
INCLUDE_EXTENSIONS=xml

# 2026/september/2026-09-13/CPJ/CPJ2026-09-13-590.xml

# --- Which date picks the folder ---------------------------------------------

# The business date inside each file, exactly as written:
#   reports  -> periodEndDate="2025-10-04T23:45:06-04:00"   => 2025-10-04
#   CPJ      -> <closedTime>2026-09-13T21:40:45-04:00</...>  => 2026-09-13
# (CPJ's first <date> is the day before, so closedTime is named, not date.)
DATE_SOURCE=CONTENT
CONTENT_DATE_FIELDS=periodEndDate,closedTime

# Only for files with no business date inside (none among the types above).
TIME_ZONE=America/New_York

# --- When to copy ----------------------------------------------------------------

# Empty copies everything already in the Archive. Compared with the business date.
COPY_FROM_DATE=

# Copied once unchanged for this long; the folder is checked this often.
STABILITY_MINUTES=1
SCAN_INTERVAL_SECONDS=60
