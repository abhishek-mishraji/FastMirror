# FastMirror .env for a GILBARCO PASSPORT store.
# Example store: Wolf, Store 13, PB Wolf Group Inc., Syracuse NY.
#
# Passport writes to two folders, and this one agent copies both:
#   Z:\BOOutBox        NAXML files (reports and the transaction journal)
#   Z:\PassportReports PDF printouts (StoreClose, ShiftClose, UNREADEMAIL)
#
# Copy this file beside FastMirror.exe, rename it to .env, set MIRROR_FOLDER (it must be changed:
# the agent refuses to start with the <STORE> placeholder in it), then start the agent.
# Every key is explained in packaging/env.template.

# --- Folders -----------------------------------------------------------------

# Z: is a mapped drive. If the agent runs from Task Scheduler before anyone logs in, mapped drives
# do not exist yet - use the \\server\share\... form of both paths instead.
SOURCE_FOLDER=//10.5.48.2/XMLGateway/BOOutBox
MIRROR_FOLDER=C:\Hands Off Software\mirrored_files\wolf_800_NY-13208

# --- XML: what to copy from BOOutBox ---------------------------------------------

# Passport file types carrying sales data, by the first 3 letters of the name:
#   PJR journal (one per transaction), MCM departments, MSM summary, FGM fuel by grade,
#   TLM tax, ISM items, FPM pump meters, TPM tank readings.
# Not listed: acknowledgements (ILTACK..., MMTACK..., ITT-EVTACK...) and system messages (SEM),
# which carry no sales and no business date. Add them only if the upload needs them.
INCLUDE_PREFIXES=PJR,MCM,MSM,FGM,TLM,ISM,FPM,TPM
INCLUDE_EXTENSIONS=xml

# MCM/2026/september/2026-09-22/MCM3402609230009421533209.xml   (MONTH drops the date folder)
GROUP_BY=DATE

# Passport names a file by when it was WRITTEN, so a day close just after midnight carries the
# next day's date in its name. The business date is only inside the file:
#   <BusinessDate>2026-09-22</BusinessDate>   in every report and every journal file
DATE_SOURCE=CONTENT
CONTENT_DATE_FIELDS=BusinessDate

# --- PDF: the PassportReports folder ------------------------------------------------

# A full path adds a folder from anywhere. Its files go to
#   PassportReports/2026/september/StoreClose20260924000416.pdf   (always grouped by month)
INCLUDE_SUBFOLDERS=\\10.5.48.2\XMLGateway\PassportReports
SUBFOLDER_EXTENSIONS=pdf

# PDFs carry no readable business date inside, but their names hold the print time:
#   StoreClose20260924000416.pdf = printed 24 Sept 2026, 00:04:16
SUBFOLDER_DATE_SOURCE=FILENAME
SUBFOLDER_FILENAME_DATE_PATTERN=*yyyyMMddHHmmss.pdf

# Passport closes the day just after midnight, so a print before 03:00 belongs to the day
# before: StoreClose20260924000416 is business day 23 Sept, and a 1 Oct 00:10 StoreClose stays in
# September. The midday shift close (~12:30) keeps its own date. (Not applied to the XML, whose
# BusinessDate is already the business day.)
BUSINESS_DAY_STARTS_AT=03:00

# StoreClose and ShiftClose are copied; UNREADEMAIL ("No mail available") is left out. The first
# three patterns are the defaults and must stay.
EXCLUDE_PATTERNS=~$*,*.tmp,*.fmtmp,UNREADEMAIL*

# --- Dates and timing -------------------------------------------------------------

# Only for files with no business date of their own (none among the types above).
TIME_ZONE=America/New_York

# Empty copies everything in both folders (BOOutBox keeps about 7 days). Compared with the
# business date.
COPY_FROM_DATE=

# Copied once unchanged for this long; the folders are checked this often.
STABILITY_MINUTES=1
SCAN_INTERVAL_SECONDS=60
