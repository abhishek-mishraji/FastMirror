<?xml version="1.0" encoding="UTF-8"?>
<!--
  Launch4j configuration for FastMirror (SRS 14.1, 14.2).

  Wraps mirror/build/libs/FastMirror.jar as FastMirror.exe in GUI mode, so the agent runs with no
  console window (FR-24) and all output goes to the log folder.

  The runtime is the jre\ directory shipped beside the exe. runtimeBits/path are relative to the
  exe's own directory, so the whole installation folder can be copied to a machine with no Java
  installed and started by double-clicking (NFR-08).

  Build:
    1. gradlew.bat fatJar
    2. launch4jc.exe packaging\launch4j.xml
    3. build the bundled runtime into the output folder as jre\ using jlink, with the module
       set "java.base,java.desktop,jdk.unsupported" (confirmed by jdeps against the built jar).

       jdk.unsupported is REQUIRED. It exports com.sun.nio.file.ExtendedWatchEventModifier,
       which is how the recursive FILE_TREE watch is registered (C-5).
       java.desktop is REQUIRED for the system-tray icon (SRS 9.11).
       Without either module the agent fails at startup.
-->
<launch4jConfig>
    <dontWrapJar>false</dontWrapJar>
    <headerType>gui</headerType>
    <jar>../mirror/build/libs/FastMirror.jar</jar>
    <outfile>../build/dist/FastMirror.exe</outfile>
    <errTitle>FastMirror</errTitle>
    <cmdLine></cmdLine>
    <chdir>.</chdir>
    <priority>normal</priority>
    <downloadUrl></downloadUrl>
    <supportUrl></supportUrl>
    <stayAlive>true</stayAlive>
    <restartOnCrash>false</restartOnCrash>
    <manifest></manifest>
    <icon></icon>

    <jre>
        <!--
          The bundled runtime, relative to the exe.

          minVersion and maxVersion are deliberately EMPTY. In Launch4j, setting a version range
          turns the bundled JRE into a preference and allows a fallback search of installed Java.
          That was verified here: with the jre\ folder renamed away, the exe happily started on an
          installed JDK instead. On a store PC that would mean a mis-copied jre\ folder silently
          launching the agent on whatever Java happens to be present - possibly Java 8, failing in
          a confusing way at runtime rather than a clear way at startup.

          With no version range, the bundled runtime is mandatory and its absence is an immediate,
          obvious error.
        -->
        <path>jre</path>
        <bundledJre64Bit>true</bundledJre64Bit>
        <bundledJreAsFallback>false</bundledJreAsFallback>
        <minVersion></minVersion>
        <maxVersion></maxVersion>
        <jdkPreference>jreOnly</jdkPreference>
        <runtimeBits>64</runtimeBits>
        <!-- NFR-04: the agent streams through a 64 KB buffer and never loads a file into memory,
             so a small heap is deliberate and makes a runaway allocation fail loudly. -->
        <opt>-Xmx256m</opt>
    </jre>

    <versionInfo>
        <fileVersion>2.0.0.0</fileVersion>
        <txtFileVersion>2.0.0</txtFileVersion>
        <fileDescription>FastMirror - Windows fast folder mirror agent</fileDescription>
        <copyright>Hands Off Retail</copyright>
        <productVersion>2.0.0.0</productVersion>
        <txtProductVersion>2.0.0</txtProductVersion>
        <productName>FastMirror</productName>
        <companyName>Hands Off Retail</companyName>
        <internalName>FastMirror</internalName>
        <originalFilename>FastMirror.exe</originalFilename>
    </versionInfo>
</launch4jConfig>
